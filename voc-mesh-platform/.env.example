# ================================
# VOC Mesh Platform - Environment Variables
# Copy to .env and fill in values
# ================================

# --- Database (TimescaleDB/PostgreSQL) ---
DATABASE_URL=postgresql://voc_user:voc_password@localhost:5432/voc_mesh
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- MQTT Broker ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_WS_URL=ws://localhost:9001
MQTT_USERNAME=voc_platform
MQTT_PASSWORD=changeme_mqtt_password

# --- Authentication ---
JWT_SECRET=changeme_jwt_secret_min_32_chars_long
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# --- Tenant Isolation ---
TENANT_ISOLATION_MODE=row_level

# --- Anthropic API (AI Insights) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Billing ---
BILLING_WEBHOOK_URL=https://billing.example.com/webhook
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# --- ML Models ---
ML_MODEL_PATH=./packages/ml-pipeline/models
ML_INFERENCE_BATCH_SIZE=100
ML_INFERENCE_INTERVAL_MS=500

# --- Edge Agent ---
EDGE_BUFFER_PATH=./.leveldb
EDGE_BATCH_SIZE=100
EDGE_FLUSH_INTERVAL_MS=500

# --- Application ---
APP_ENV=development
APP_PORT=8000
DASHBOARD_PORT=5173
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
